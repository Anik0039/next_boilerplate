# Server-only deployment settings. Never prefix secrets with NEXT_PUBLIC_.
# Production always enforces CSP; this switch permits report-only observation only outside production.
CSP_MODE=enforce
ENABLE_DEMO_API=false
APP_ORIGINS=https://cib.example.com
CSRF_SECRET=
# Enable only when the approved gateway strips spoofed forwarding headers and injects canonical values.
TRUST_PROXY_HEADERS=false

# These values are placeholders until the UMS and BFF contracts are verified.
UMS_ISSUER_URL=
UMS_CLIENT_ID=
BACKEND_API_BASE_URL=
